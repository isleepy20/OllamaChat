<?xml version="1.0" encoding="utf-8"?>
<!--
  Ollama speaks plain HTTP. LAN addresses (192.168.x.x, 10.x.x.x, 172.16-31.x.x) cannot be
  listed by CIDR in a network security config, so cleartext is permitted for all hosts.
  This app only talks to the server URL you enter in Settings.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
